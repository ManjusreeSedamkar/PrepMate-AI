# PrepMate AI - Backend Environment Variables

# Your Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Server Port (Render sets this dynamically via PORT environment variable)
PORT=8000
HOST=0.0.0.0

# Allowed CORS Origins (comma-separated or * for all)
CORS_ORIGINS=*
